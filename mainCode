    public static void saveForm(String name , String mail, String dob, String address, String pass){
        String command = "insert into voterAdd (name, email, DOB,  address,password ) values (?,?,?,?,?)";

        try (Connection conn = DriverManager.getConnection(DB_URL, DB_USER, DB_PASSWORD);
             PreparedStatement stmt = conn.prepareStatement(command)) {

            stmt.setString(1, name);
            stmt.setString(2, mail);
            stmt.setString(3,dob);
            stmt.setString(4,address);
            stmt.setString(5,pass);

            int rowsInserted = stmt.executeUpdate();

            if (rowsInserted > 0) {
                System.out.println("Data successfully saved to the database!");
            }

        } catch (SQLException e) {
            System.err.println("❌ Database error: " + e.getMessage());
        }
    }

