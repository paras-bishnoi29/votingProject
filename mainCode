    private static void verifyForm( int id, String table){
        try(Connection con = DriverManager.getConnection(DB_URL,DB_USER,DB_PASSWORD);
            Statement stmt = con.createStatement()){
            ResultSet rs = stmt.executeQuery("SELECT * FROM "+table+" where id =" +id);

            if(table.equals("voterAdd")){
                while(rs.next()) {
                    String Name = rs.getString("name");
                    String Email = rs.getString("email");
                    String Address = rs.getString("address");
                    String DOB = rs.getString("DOB");
                    String Pass = rs.getString("password");
                    String gender = rs.getString("gender");
                    saveUser(id, Name, Email, DOB, Address, Pass, gender);
                }
            }
            else if(table.equals("candidateAdd")){
                while (rs.next()){
                    String name = rs.getString("name");
                    String dob = rs.getString("DOB");
                    String manifesto = rs.getString("manifesto");
                    String education = rs.getString("education");
                    String gender = rs.getString("gender");
                    saveCandidate(id,name,dob,manifesto,education,gender);
                }
            }
            con.close();
        }

        catch (SQLException e){
            System.out.println("Database error in verify form "+e.getMessage());
        }
    }

